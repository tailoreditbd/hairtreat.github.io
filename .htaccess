# Keep clean no-trailing-slash routes from being redirected to physical directories.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# URL Rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /hairtreat/  # Local XAMPP base
  # RewriteBase /             # Live server base - change before uploading
  RewriteBase /hairtreat/

  # Permanently remove the accidentally duplicated treatment path
  RewriteRule ^treatments/treatments/laser-hair-removal/?$ - [G,L]

  # Migrate legacy, flat, and previously classified service URLs
  RewriteRule ^treatments/(hair-prp|hair-line-correction|gfc-prp)(?:/index\.html|/)?$ hair-treatments/$1 [NC,R=301,L]
  RewriteRule ^treatments/fue(?:/index\.html|/)?$ hair-treatments/hair-transplant/fue [NC,R=301,L]
  RewriteRule ^treatments/(laser-hair-removal|p-shot)(?:/index\.html|/)?$ other-treatments/$1 [NC,R=301,L]
  RewriteRule ^treatments/hair-transplant(?:/index\.html|/)?$ hair-treatments/hair-transplant [NC,R=301,L]
  RewriteRule ^transplant/hair-transplant(?:/index\.html|/)?$ hair-treatments/hair-transplant [NC,R=301,L]
  RewriteRule ^transplant/(hair-prp|hair-line-correction|gfc-prp)(?:/index\.html|/)?$ hair-treatments/$1 [NC,R=301,L]
  RewriteRule ^transplant/(fue|eyebrow-transplant|female-hair-transplant|beard-transplant|fut-hair-transplant|sapphire-hair-transplant)(?:/index\.html|/)?$ hair-treatments/hair-transplant/$1 [NC,R=301,L]
  RewriteRule ^hair-treatments/(fue|eyebrow-transplant|female-hair-transplant|beard-transplant|fut-hair-transplant|sapphire-hair-transplant)(?:/index\.html|/)?$ hair-treatments/hair-transplant/$1 [NC,R=301,L]
  RewriteRule ^hair-treatments/(laser-hair-removal|p-shot)(?:/index\.html|/)?$ other-treatments/$1 [NC,R=301,L]
  RewriteRule ^other-treatments/(hair-prp|hair-line-correction|gfc-prp)(?:/index\.html|/)?$ hair-treatments/$1 [NC,R=301,L]
  RewriteRule ^other-treatments/(fue|eyebrow-transplant|female-hair-transplant|beard-transplant|fut-hair-transplant|sapphire-hair-transplant)(?:/index\.html|/)?$ hair-treatments/hair-transplant/$1 [NC,R=301,L]

  # Canonicalize Hair Transplant and its nested services
  RewriteRule ^hair-treatments/hair-transplant/$ hair-treatments/hair-transplant [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*hair-treatments/hair-transplant/index\.html(?:[?\s]) [NC]
  RewriteRule ^hair-treatments/hair-transplant/index\.html$ hair-treatments/hair-transplant [NC,R=301,L]
  RewriteRule ^hair-treatments/hair-transplant/(hair-prp|hair-line-correction|gfc-prp)(?:/index\.html|/)?$ hair-treatments/$1 [NC,R=301,L]
  RewriteRule ^hair-treatments/hair-transplant/(fue|eyebrow-transplant|female-hair-transplant|beard-transplant|fut-hair-transplant|sapphire-hair-transplant)/$ hair-treatments/hair-transplant/$1 [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*hair-treatments/hair-transplant/[^/\s?]+/index\.html(?:[?\s]) [NC]
  RewriteRule ^hair-treatments/hair-transplant/(fue|eyebrow-transplant|female-hair-transplant|beard-transplant|fut-hair-transplant|sapphire-hair-transplant)/index\.html$ hair-treatments/hair-transplant/$1 [NC,R=301,L]
  RewriteRule ^hair-treatments/(hair-prp|hair-line-correction|gfc-prp)/$ hair-treatments/$1 [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*hair-treatments/(?:hair-prp|hair-line-correction|gfc-prp)/index\.html(?:[?\s]) [NC]
  RewriteRule ^hair-treatments/(hair-prp|hair-line-correction|gfc-prp)/index\.html$ hair-treatments/$1 [NC,R=301,L]
  RewriteRule ^other-treatments/(laser-hair-removal|p-shot)/$ other-treatments/$1 [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*other-treatments/[^/\s?]+/index\.html(?:[?\s]) [NC]
  RewriteRule ^other-treatments/(laser-hair-removal|p-shot)/index\.html$ other-treatments/$1 [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(.*/)?other-treatments/laser-hair-removal/facial-hair/(?:index\.html)?[?\s] [NC]
  RewriteRule ^other-treatments/laser-hair-removal/facial-hair/(?:index\.html)?$ other-treatments/laser-hair-removal/facial-hair [NC,R=301,L]

  # Redirect old branch subpaths to direct static pages so assets load correctly
  RewriteRule ^service-area(-)?\.html/(uttara|uttura)$ service-area/uttara [NC,R=301,L]
  RewriteRule ^service-area(-)?\.html/gulshan$ service-area/gulshan [NC,R=301,L]
  RewriteRule ^service-area(-)?\.html/dhaka$ service-area/dhaka [NC,R=301,L]
  RewriteRule ^(.*)/service-area\.html$ service-area [NC,R=301,L]
  RewriteRule ^(.*)/image(s)?-gallery\.html$ image-gallery [NC,R=301,L]

  # Redirect legacy and trailing-slash URLs to canonical clean URLs
  RewriteRule ^about/$ about [NC,R=301,L]
  RewriteRule ^beard-transplant/?$ hair-treatments/hair-transplant/beard-transplant [NC,R=301,L]
  RewriteRule ^blog-single/$ blog-single [NC,R=301,L]
  RewriteRule ^blog/$ blog [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*blog/index\.html(?:[?\s]) [NC]
  RewriteRule ^blog/index\.html$ blog [NC,R=301,L]
  RewriteRule ^top-10-hair-transplant-clinics-in-bangladesh/?$ blog/top-10-hair-transplant-clinics-in-bangladesh [NC,R=301,L]
  RewriteRule ^blog/top-10-hair-transplant-clinics-in-bangladesh/$ blog/top-10-hair-transplant-clinics-in-bangladesh [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*blog/top-10-hair-transplant-clinics-in-bangladesh\.html(?:[?\s]) [NC]
  RewriteRule ^blog/top-10-hair-transplant-clinics-in-bangladesh\.html$ blog/top-10-hair-transplant-clinics-in-bangladesh [NC,R=301,L]
  RewriteRule ^blog/best-hair-transplant-service-bangladesh/$ blog/best-hair-transplant-service-bangladesh [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*blog/best-hair-transplant-service-bangladesh\.html(?:[?\s]) [NC]
  RewriteRule ^blog/best-hair-transplant-service-bangladesh\.html$ blog/best-hair-transplant-service-bangladesh [NC,R=301,L]
  RewriteRule ^book-appointment/$ book-appointment [NC,R=301,L]
  RewriteRule ^blog/top-10-hair-transplant-surgeons-in-bangladesh/$ blog/top-10-hair-transplant-surgeons-in-bangladesh [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/+[^\s?]*blog/top-10-hair-transplant-surgeons-in-bangladesh\.html(?:[?\s]) [NC]
  RewriteRule ^blog/top-10-hair-transplant-surgeons-in-bangladesh\.html$ blog/top-10-hair-transplant-surgeons-in-bangladesh [NC,R=301,L]
  RewriteRule ^case-study-single/$ case-study-single [NC,R=301,L]
  RewriteRule ^case-study/$ case-study [NC,R=301,L]
  RewriteRule ^codex-server-check/$ codex-server-check [NC,R=301,L]
  RewriteRule ^contact-us/$ contact-us [NC,R=301,L]
  RewriteRule ^contact/$ contact-us [NC,R=301,L]
  RewriteRule ^dhaka/?$ service-area/dhaka [NC,R=301,L]
  RewriteRule ^eyebrow-transplant/?$ hair-treatments/hair-transplant/eyebrow-transplant [NC,R=301,L]
  RewriteRule ^faqs/$ faqs [NC,R=301,L]
  RewriteRule ^female-hair-transplant/?$ hair-treatments/hair-transplant/female-hair-transplant [NC,R=301,L]
  RewriteRule ^form/$ form [NC,R=301,L]
  RewriteRule ^fue/?$ hair-treatments/hair-transplant/fue [NC,R=301,L]
  RewriteRule ^fut-hair-transplant/?$ hair-treatments/hair-transplant/fut-hair-transplant [NC,R=301,L]
  RewriteRule ^gfc-prp/?$ hair-treatments/gfc-prp [NC,R=301,L]
  RewriteRule ^gulshan/?$ service-area/gulshan [NC,R=301,L]
  RewriteRule ^hair-line-correction/?$ hair-treatments/hair-line-correction [NC,R=301,L]
  RewriteRule ^hair-loss-treatment-for-saudi-arabia-nrbs/$ hair-loss-treatment-for-saudi-arabia-nrbs [NC,R=301,L]
  RewriteRule ^hair-prp/?$ hair-treatments/hair-prp [NC,R=301,L]
  RewriteRule ^hair-transplant-technique/$ hair-transplant-technique [NC,R=301,L]
  RewriteRule ^hair-transplant-treatment/$ hair-transplant-treatment [NC,R=301,L]
  RewriteRule ^hair-transplant/?$ hair-treatments/hair-transplant [NC,R=301,L]
  RewriteRule ^hours-and-location/$ hours-and-location [NC,R=301,L]
  RewriteRule ^image-gallery/$ image-gallery [NC,R=301,L]
  RewriteRule ^index-image/$ index-image [NC,R=301,L]
  RewriteRule ^index-slider/$ index-slider [NC,R=301,L]
  RewriteRule ^index-video/$ index-video [NC,R=301,L]
  RewriteRule ^laser-hair-remover/?$ other-treatments/laser-hair-removal [NC,R=301,L]
  RewriteRule ^laser-hair-removal/?$ other-treatments/laser-hair-removal [NC,R=301,L]
  RewriteRule ^laser-treatment/$ laser-treatment [NC,R=301,L]
  RewriteRule ^moustache-transplant/$ moustache-transplant [NC,R=301,L]
  RewriteRule ^p-shot/?$ other-treatments/p-shot [NC,R=301,L]
  RewriteRule ^hair-transplant-cost/$ hair-transplant-cost [NC,R=301,L]
  RewriteRule ^reviews/$ reviews [NC,R=301,L]
  RewriteRule ^sapphire-hair-transplant/?$ hair-treatments/hair-transplant/sapphire-hair-transplant [NC,R=301,L]
  RewriteRule ^service-area/(dhaka|gulshan|uttara)/$ service-area/$1 [NC,R=301,L]
  RewriteRule ^service-area/$ service-area [NC,R=301,L]
  RewriteRule ^service-single/$ service-single [NC,R=301,L]
  RewriteRule ^team-single/$ team-single [NC,R=301,L]
  RewriteRule ^team/$ team [NC,R=301,L]
  RewriteRule ^transplant/?$ other-treatments [NC,R=301,L]
  RewriteRule ^other-treatments/$ other-treatments [NC,R=301,L]
  RewriteRule ^treatments/?$ hair-treatments [NC,R=301,L]
  RewriteRule ^hair-treatments/$ hair-treatments [NC,R=301,L]
  RewriteRule ^uttara/?$ service-area/uttara [NC,R=301,L]
  RewriteRule ^video-gallery/$ video-gallery [NC,R=301,L]

  # Redirect direct .html access to clean URLs
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*about\.html[?\s] [NC]
  RewriteRule ^about\.html$ about [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*beard-transplant\.html[?\s] [NC]
  RewriteRule ^beard-transplant\.html$ hair-treatments/hair-transplant/beard-transplant [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*blog-single\.html[?\s] [NC]
  RewriteRule ^blog-single\.html$ blog-single [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*blog\.html[?\s] [NC]
  RewriteRule ^blog\.html$ blog [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*top-10-hair-transplant-clinics-in-bangladesh\.html[?\s] [NC]
  RewriteRule ^top-10-hair-transplant-clinics-in-bangladesh\.html$ blog/top-10-hair-transplant-clinics-in-bangladesh [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*book-appointment\.html[?\s] [NC]
  RewriteRule ^book-appointment\.html$ book-appointment [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*case-study-single\.html[?\s] [NC]
  RewriteRule ^case-study-single\.html$ case-study-single [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*case-study\.html[?\s] [NC]
  RewriteRule ^case-study\.html$ case-study [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*codex-server-check\.html[?\s] [NC]
  RewriteRule ^codex-server-check\.html$ codex-server-check [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*contact-us\.html[?\s] [NC]
  RewriteRule ^contact-us\.html$ contact-us [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*contact\.html[?\s] [NC]
  RewriteRule ^contact\.html$ contact-us [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*dhaka\.html[?\s] [NC]
  RewriteRule ^dhaka\.html$ service-area/dhaka [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*eyebrow-transplant\.html[?\s] [NC]
  RewriteRule ^eyebrow-transplant\.html$ hair-treatments/hair-transplant/eyebrow-transplant [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*faqs\.html[?\s] [NC]
  RewriteRule ^faqs\.html$ faqs [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*female-hair-transplant\.html[?\s] [NC]
  RewriteRule ^female-hair-transplant\.html$ hair-treatments/hair-transplant/female-hair-transplant [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*form\.html[?\s] [NC]
  RewriteRule ^form\.html$ form [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*fue\.html[?\s] [NC]
  RewriteRule ^fue\.html$ hair-treatments/hair-transplant/fue [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*fut-hair-transplant\.html[?\s] [NC]
  RewriteRule ^fut-hair-transplant\.html$ hair-treatments/hair-transplant/fut-hair-transplant [NC,R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^/]+/)*gfc-prp\.html[?\s] [NC]
